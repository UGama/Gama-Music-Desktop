{
  "name": "gama-music-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Gama Music desktop app and iPhone music server.",
  "type": "commonjs",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/server.js",
    "desktop": "electron .",
    "check": "node server/check-env.js",
    "icons": "node scripts/make-icons.js",
    "prepare:vendor": "node scripts/prepare-vendor.js",
    "build:mac": "npm run prepare:vendor && electron-builder --mac",
    "build:dmg": "npm run prepare:vendor && electron-builder --mac dmg --arm64"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.gama.music",
    "productName": "Gama Music",
    "artifactName": "Gama-Music-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "web/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ]
    },
    "extraResources": [
      {
        "from": "vendor/mac-arm64",
        "to": "vendor/mac-arm64"
      }
    ]
  }
}
